; Engine configuration file.
config_version=5

[application]
config/name="Wandering Sword Survivors"
config/description="Original wuxia survivors-like — Godot remake"
config/version="0.2.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/placeholders/icon.svg"


[gui]
theme/custom="res://resources/ui/default_theme.tres"
[autoload]
GameState="*res://scripts/autoload/game_state.gd"
SaveService="*res://scripts/autoload/save_service.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
LocaleService="*res://scripts/autoload/locale_service.gd"
PoolManager="*res://scripts/autoload/pool_manager.gd"
OrientationGate="*res://scripts/ui/orientation_gate.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

